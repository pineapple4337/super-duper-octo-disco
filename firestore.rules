rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /questions/{id} {
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly(['text','status','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300;

      // Public users may read approved documents. Signed-in moderator may read all.
      allow read: if resource.data.status == 'approved' || request.auth != null;

      // For this small private-admin app, only signed-in accounts may moderate.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending','approved','rejected'];

      allow delete: if false;
    }
  }
}
